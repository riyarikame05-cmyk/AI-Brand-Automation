@app.get("/projects")
def get_projects(
    db: Session = Depends(
        get_db
    ),
):

    projects = (
        db.query(
            Project
        )
        .order_by(
            Project.created_at.desc()
        )
        .all()
    )


    return {
        "projects": [
            project_to_dict(
                project
            )

            for project
            in projects
        ]
    }


