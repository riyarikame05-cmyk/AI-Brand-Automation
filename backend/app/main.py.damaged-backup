def get_local_path(
    asset: Asset,
):

    if not asset.url:

        return None


    if "/generated/" not in asset.url:

        return None


    filename = (
        asset.url
        .split(
            "/generated/"
        )[-1]
    )


    # Avoid accepting paths such as ../../file.

    filename = (
        Path(filename).name
    )


    return (
        GENERATED_DIR
        / filename
    )


# =========================================================
# COLOR EXTRACTION
# =========================================================

def extract_palette(
    file_path: Path,
):

    colors = (
        extract_dominant_colors(
            file_path,

            number_of_colors=3,
        )
    )


    if not colors:

        raise ValueError(
            "No colors were extracted."
        )


    colors = list(
        colors
    )


    while len(
        colors
    ) < 3:

        colors.append(
            colors[-1]
        )


    return {
        "primary_color":
            colors[0],

        "secondary_color":
            colors[1],

        "accent_color":
            colors[2],
    }


# =========================================================
# CREATE LOGO CONCEPTS
# =========================================================
def clean_extracted_palette(
    palette: dict,
) -> dict:
    """
    Clean colors extracted from a finished logo.

    White or near-white colors usually come from the logo
    background and should not become primary brand colors.
    """

    fallback_colors = [
        "#111827",
        "#6366F1",
        "#8B5CF6",
    ]

    keys = [
        "primary_color",
        "secondary_color",
        "accent_color",
    ]

    def is_near_white(value: str) -> bool:
        if not isinstance(value, str):
            return True

        value = value.strip().lstrip("#")

        if len(value) != 6:
            return True

        try:
            red = int(value[0:2], 16)
            green = int(value[2:4], 16)
            blue = int(value[4:6], 16)
        except ValueError:
            return True

        return (
            red >= 240
            and green >= 240
            and blue >= 240
        )

    cleaned = {}

    for index, key in enumerate(keys):
        color = palette.get(key)

        if not color or is_near_white(color):
            color = fallback_colors[index]

        cleaned[key] = color

        return cleaned


def create_logo_concepts(
    project: Project,
    db: Session,
    count: int = 3,
):
    """
    Generate a batch of local logo concepts.

    Creative directions continue across multiple batches:

        0 = Minimal Geometric
        1 = Negative Space
        2 = Monogram / Lettermark
        3 = Abstract Motion
        4 = Wordmark
        5 = Brand Emblem

    The frontend currently requests logos in batches of three,
    so requesting six concepts results in two API calls while
    still producing six different creative directions.
        """

    concepts = []

    # -----------------------------------------------------
    # COUNT EXISTING LOGOS
    # -----------------------------------------------------

    existing_logo_count = (
        db.query(Asset)
        .filter(
            Asset.project_id == project.id,
            Asset.asset_type == "logo",
        )
        .count()
    )

    print("")
    print("========================================")
    print("[LOGO] STARTING LOGO BATCH")
    print(f"[LOGO] Project: {project.id}")
    print(f"[LOGO] Business: {project.business_name}")
    print(f"[LOGO] Existing concepts: {existing_logo_count}")
    print(f"[LOGO] New concepts requested: {count}")
    print("========================================")

    try:
        for number in range(count):

            # -------------------------------------------------
            # CONTINUE DIRECTION SEQUENCE ACROSS API CALLS
            # -------------------------------------------------

            absolute_index = (
                existing_logo_count
                + number
            )

            direction_index = (
                absolute_index % 6
            )

            concept_number = (
                absolute_index + 1
            )

            print("")
            print("----------------------------------------")
            print(
                f"[LOGO] Generating concept "
                f"{concept_number}"
            )
            print(
                f"[LOGO] Creative direction: "
                f"{direction_index}"
            )
            print("----------------------------------------")

            # -------------------------------------------------
            # GENERATE LOGO
            # -------------------------------------------------

            image_bytes = generate_logo_image(
                business_name=project.business_name,
                industry=project.industry,
                style=project.style,
                description=project.description,
                direction_index=direction_index,
                provider="local",
            )

            # -------------------------------------------------
            # VALIDATE IMAGE
            # -------------------------------------------------

            if not isinstance(
                image_bytes,
                (bytes, bytearray),
            ):
                raise RuntimeError(
                    "Logo generator returned invalid image data."
                )

            if len(image_bytes) < 1000:
                raise RuntimeError(
                    "Generated logo is too small or invalid."
                )
            # -------------------------------------------------
            # SAVE PNG
            # -------------------------------------------------

            filename = (
                f"{project.id}-"
                f"logo-{concept_number}-"
                f"{uuid.uuid4()}.png"
            )

            file_path = (
                GENERATED_DIR
                / filename
            )

            file_path.write_bytes(
                bytes(image_bytes)
            )

            image_url = (
                "http://127.0.0.1:8000"
                f"/generated/{filename}"
            )

            # -------------------------------------------------
            # EXTRACT DISPLAY PALETTE
            # -------------------------------------------------

            try:
                palette = extract_palette(
                    file_path
                )

                # The finished logo has a white background.
                # Replace near-white extracted colors so they
                # do not become misleading brand colors.
                palette = clean_extracted_palette(
                    palette
                )

            except Exception as error:
                print(
                    "[COLOR] Extraction failed:",
                    repr(error),
                )

                palette = {
                    "primary_color": "#111827",
                    "secondary_color": "#6366F1",
                    "accent_color": "#8B5CF6",
                }

            # -------------------------------------------------
            # CREATE DATABASE ASSET
            # -------------------------------------------------

            asset = Asset(
                project_id=project.id,
                asset_type="logo",
                url=image_url,
                prompt=(
                    f"Logo concept {concept_number} "
                    f"for {project.business_name} "
                    f"(direction {direction_index})"
                ),
                is_selected=False,
            )

            db.add(asset)
            db.flush()

            concepts.append(
                {
                    "asset": asset,
                    "palette": palette,
                }
            )

            print(
                f"[LOGO] Concept "
                f"{concept_number} complete."
            )

        print("")
        print("========================================")
        print(
            f"[LOGO] Generated {len(concepts)} "
            "concepts successfully."
        )
        print("========================================")

        return concepts

        except Exception as error:
        db.rollback()

        print(
            "[LOGO] Batch failed:",
            repr(error),
        )

        # Completed concepts have already been committed.
        # Do not delete their image files if a later
        # concept fails.

        raise

    # =====================================================
    # CONTINUE CREATIVE DIRECTIONS ACROSS BATCHES
    # =====================================================
    #
    # The frontend requests logos in batches of 3.
    #
    # Batch 1:
    #   0 = minimal geometric
    #   1 = negative space
    #   2 = monogram
    #
    # Batch 2:
    #   3 = abstract motion
    #   4 = wordmark
    #   5 = brand emblem
    #
    # Batch 3 (for 9 concepts):
    #   cycles through the same families with fresh
    #   Ollama generations.
    # =====================================================

    existing_logo_count = (
        db.query(Asset)
        .filter(
            Asset.project_id == project.id,
            Asset.asset_type == "logo",
        )
        .count()
    )

    print(
        f"[LOGO] Existing logo concepts: "
        f"{existing_logo_count}"
    )


    try:

        for number in range(
            count
        ):

            direction_index = (
                existing_logo_count + number
            ) % 6


            print("")
            print(
                "========================================"
            )

            print(
                f"[LOGO] Generating "
                f"{number + 1}/{count}"
            )

            print(
                f"[LOGO] Business: "
                f"{project.business_name}"
            )

            print(
                f"[LOGO] Creative direction: "
                f"{direction_index}"
            )

            print(
                "========================================"
            )


            # =============================================
            # HYBRID LOGO GENERATION
            #
            # IMAGE_PROVIDER=auto:
            #
            # Replicate
            #    â†“ failure
            # FLUX
            #    â†“ failure
            # local renderer
            # =============================================

            image_bytes = (
                generate_logo_image(
                    business_name=(
                        project.business_name
                    ),

                    industry=(
                        project.industry
                    ),

                    style=(
                        project.style
                    ),

                    description=(
                        project.description
                    ),

                    direction_index=(
                        direction_index
                    ),

                    provider=None,
                )
            )


            # =============================================
            # VALIDATE GENERATED IMAGE
            # =============================================

            if not isinstance(
                image_bytes,
                (
                    bytes,
                    bytearray,
                ),
            ):

                raise RuntimeError(
                    "Logo generator returned "
                    "invalid image data."
                )


            if len(
                image_bytes
            ) < 1000:

                raise RuntimeError(
                    "Generated logo is "
                    "too small or invalid."
                )


            # =============================================
            # SAVE LOGO
            # =============================================

            filename = (
                f"{project.id}-"
                f"logo-"
                f"{uuid.uuid4()}.png"
            )


            file_path = (
                GENERATED_DIR
                / filename
            )


            file_path.write_bytes(
                bytes(
                    image_bytes
                )
            )


            created_files.append(
                file_path
            )


            image_url = (
                "http://127.0.0.1:8000"
