@app.post("/brand")
def create_brand(
    brand: BrandRequest,

    db: Session = Depends(
        get_db
    ),
):

    # =====================================================
    # VALIDATE INPUT
    # =====================================================

    business_name = (
        brand.business_name
        .strip()
    )


    description = (
        brand.description
        .strip()
    )


    industry = (
        brand.industry
        .strip()
    )


    style = (
        brand.style
        .strip()
    )


    if not business_name:

        raise HTTPException(
            status_code=400,

            detail=(
                "Business name is required."
            ),
        )


    if not description:

        raise HTTPException(
            status_code=400,

            detail=(
                "Business description "
                "is required."
            ),
        )


    if not industry:

        raise HTTPException(
            status_code=400,

            detail=(
                "Industry is required."
            ),
        )


    if not style:

        raise HTTPException(
            status_code=400,

            detail=(
                "Brand style is required."
            ),
        )


    # =====================================================
    # CREATE PROJECT
    # =====================================================

    try:

        project = Project(
            business_name=(
                business_name
            ),

            description=(
                description
            ),

            industry=(
                industry
            ),

            style=(
                style
            ),
        )


        db.add(
            project
        )


        db.commit()


        db.refresh(
            project
        )


        print(
            "[BRAND] Project created:",
            project.id,
        )


    except Exception as error:

        db.rollback()


        print(
            "[BRAND] Project creation error:",
            repr(error),
        )


        raise HTTPException(
            status_code=500,

            detail=(
                "Could not create project."
            ),
        )


    # =====================================================
    # BRAND INTELLIGENCE
    # =====================================================

    try:

        print(
            "[AI] Generating "
            "brand intelligence..."
        )


        intelligence = (
            generate_brand_intelligence(
                business_name=(
                    project.business_name
                ),

                industry=(
                    project.industry
                ),

                description=(
                    project.description
                ),

                style=(
                    project.style
                ),
            )
        )


        if not isinstance(
            intelligence,
            dict,
        ):

            raise RuntimeError(
                "Brand intelligence "
                "returned invalid data."
            )


        print(
            "[AI] Brand intelligence complete."
        )


    except Exception as error:

        print(
            "[AI] Ollama unavailable:",
            repr(error),
        )


        # =============================================
        # SAFE FALLBACK STRATEGY
        # =============================================

        intelligence = {
            "slogan":
                "Built For What Comes Next",

            "personality": [
                "Professional",
                "Modern",
                "Reliable",
            ],

            "tone":
                (
                    "Clear, confident "
                    "and professional"
                ),

            "target_audience":
                (
                    "Customers seeking "
                    "quality and reliability"
                ),

            "marketing_message":
                (
                    "A modern brand built "
                    "around quality, trust "
                    "and customer value."
                ),

            "typography": {
                "heading":
                    "Montserrat",

                "body":
                    "Inter",
            },
        }


    # =====================================================
    # NORMALIZE INTELLIGENCE
    # =====================================================

    typography = (
        intelligence.get(
            "typography",
            {},
        )
    )


    if not isinstance(
        typography,
        dict,
    ):

        typography = {}


    personality = (
        intelligence.get(
            "personality",
            [],
        )
    )


    if not isinstance(
        personality,
        list,
    ):

        personality = []


    # =====================================================
    # CREATE BRAND KIT
    # =====================================================

    try:

        brand_kit = BrandKit(
            project_id=(
                project.id
            ),

            # Temporary palette until
            # a logo is selected.

            primary_color=(
                "#111827"
            ),

            secondary_color=(
                "#6366F1"
            ),

            accent_color=(
                "#8B5CF6"
            ),

            slogan=(
                intelligence.get(
                    "slogan",
                    "",
                )
                or ""
            ),

            personality=(
                json.dumps(
                    personality
                )
            ),

            tone=(
                intelligence.get(
                    "tone",
                    "",
                )
                or ""
            ),

            target_audience=(
                intelligence.get(
                    "target_audience",
                    "",
                )
                or ""
            ),

            marketing_message=(
                intelligence.get(
                    "marketing_message",
                    "",
                )
                or ""
            ),

            heading_font=(
                typography.get(
                    "heading",
                    "Montserrat",
                )
                or "Montserrat"
            ),

            body_font=(
                typography.get(
                    "body",
                    "Inter",
                )
                or "Inter"
            ),
        )


        db.add(
            brand_kit
        )


        db.commit()


        db.refresh(
            brand_kit
        )


        print(
            "[BRAND] Brand kit saved."
        )


    except Exception as error:

        db.rollback()


        print(
            "[BRAND] Brand kit error:",
            repr(error),
        )


        raise HTTPException(
            status_code=500,

            detail=(
                "Project was created, "
                "but brand kit creation failed."
            ),
        )


    return {
        "message":
            "Brand project created",

        "project":
            project_to_dict(
                project
            ),

        "brand_kit":
            brand_kit_to_dict(
                brand_kit
            ),

        "concepts":
            [],
    }


