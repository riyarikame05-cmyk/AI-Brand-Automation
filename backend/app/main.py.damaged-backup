@app.get(
    "/projects/{project_id}/assets"
)
def get_assets(
    project_id: UUID,

    db: Session = Depends(
        get_db
    ),
):

    project = (
        db.query(
            Project
        )
        .filter(
            Project.id
            == project_id
        )
        .first()
    )


    if not project:

        raise HTTPException(
            status_code=404,

            detail=(
                "Project not found."
            ),
        )


    assets = (
        db.query(
            Asset
        )
        .filter(
            Asset.project_id
            == project.id
        )
        .order_by(
            Asset.created_at.desc()
        )
        .all()
    )


    result = []


    for asset in assets:

        data = (
            asset_to_dict(
                asset
            )
        )


        if (
            asset.asset_type
            == "logo"
        ):

            file_path = (
                get_local_path(
                    asset
                )
            )


            if (
                file_path
                and file_path.exists()
            ):

                try:

                    data[
                        "palette"
                    ] = (
                        extract_palette(
                            file_path
                        )
                    )


                except Exception as error:

                    print(
                        "[COLOR] Asset palette error:",
                        repr(error),
                    )


                    data[
                        "palette"
                    ] = None


            else:

                data[
                    "palette"
                ] = None


        result.append(
            data
        )


    return {
        "assets":
            result
    }


