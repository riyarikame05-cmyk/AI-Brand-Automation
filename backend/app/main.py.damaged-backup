# GENERATE 3 LOGO CONCEPTS
# =========================================================

@app.post(
    "/projects/{project_id}/generate-logo"
)
def generate_more_logos(
    project_id: UUID,

    db: Session = Depends(
        get_db
    ),
):

    project = (
        db.query(
            Project
        )
        .filter(
            Project.id
            == project_id
        )
        .first()
    )


    if not project:

        raise HTTPException(
            status_code=404,

            detail=(
                "Project not found."
            ),
        )


    try:

        print(
            "[LOGO] Starting logo batch "
            f"for project {project.id}"
        )


        concepts = (
            create_logo_concepts(
                project=(
                    project
                ),

                db=(
                    db
                ),

                count=3,
            )
        )


        db.commit()


        for concept in concepts:

            db.refresh(
                concept[
                    "asset"
                ]
            )


        print(
            "[LOGO] Batch complete."
        )


        return {
            "message":
                (
                    "3 logo concepts "
                    "generated"
                ),

            "concepts": [
                {
                    **asset_to_dict(
                        concept[
                            "asset"
                        ]
                    ),

                    "palette":
                        concept[
                            "palette"
                        ],
                }

                for concept
                in concepts
            ],
        }


